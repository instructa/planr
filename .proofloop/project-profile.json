  "validation": {
    "cwd": ".",
    "command": "cargo test --bin planr app::execution_run::tests::source_frozen_final_review_repair_retry_refreezes_once -- --exact --test-threads=1",
    "full_suite_command": "cargo test --bins",
    "timeout_seconds": 900
  },
  "testing": {
    "strategy": "distill",
    "tracked_test_globs": [
      "tests/**",
      "**/tests/**",
      "*_test.*",
      "**/*_test.*",
      "*.test.*",
      "**/*.test.*",
      "*.spec.*",
      "**/*.spec.*",
      "tests/e2e.rs",
      "src/evidence/execution.rs",
      "src/evidence/import.rs",
      "src/app/execution_run.rs",
      "src/app/execution_state.rs",
      "src/app/feature_run_evidence.rs"
    ],
    "build": {
      "permanent_test_edits": "deny",
      "full_suite": "deny"
    },
    "harden": {
      "permanent_test_edits": "admission-required",
      "max_new_invariants": 1,
      "max_changed_test_files": 1,
      "max_added_test_lines": 70,
      "full_suite": "ci-or-explicit"
    }
  },
  "evidence": {
    "directory": ".proofloop/evidence",
    "required": [
      "diff",
      "validation-result",
      "test-gate",
      "handoff"
    ]
  },
  "budgets": {
    "checkpoint_minutes": 20,
    "hard_stop_minutes": 45,
    "max_patch_batches": 1
  },
  "stop_conditions": [
    "out-of-scope write",
    "second writer or nested delegation",
    "hypothesis disproved or scope broadened",
    "context compaction during design-sensitive work",
    "checkpoint or hard-stop exceeded"
  ],
  "manual_acceptance": {
    "required": false,
    "owner": "human",
    "criteria": []
  },
  "pane_policy": {
    "reuse_suitable_existing": true,
    "record_created": true,
    "close_recorded_only": true,
    "max_completed_workflow_panes": 0
  }
