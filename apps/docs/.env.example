# Public absolute origin used for canonical metadata in production.
NEXT_PUBLIC_SITE_URL=https://docs.planr.so

# Cloudflare + Alchemy deployment. Keep real values in apps/docs/.env.local.
ALCHEMY_PASSWORD=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# `docs.planr.so` is attached only when this is `prod`.
STAGE=dev
