{
  "name": "@planr/docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "alchemy:dev": "alchemy dev --stage dev",
    "build": "next build && node scripts/prepare-static-assets.mjs",
    "start": "wrangler dev --config wrangler.jsonc --port 3000 --local",
    "deploy": "alchemy deploy --stage prod --yes",
    "destroy": "alchemy destroy --stage prod",
    "content": "fumadocs-mdx && node scripts/verify-grok-inventory.mjs && node scripts/verify-pi-inventory.mjs",
    "typecheck": "fumadocs-mdx && tsc --noEmit",
    "lint": "eslint .",
    "verify:onboarding": "node scripts/verify-onboarding.mjs",
    "verify:agent-recipes": "node scripts/verify-agent-recipes.mjs",
    "verify:agent-markdown": "node scripts/verify-agent-markdown.mjs",
    "verify:agent-journey": "node scripts/verify-agent-journey.mjs",
    "verify:agent-landing": "node scripts/verify-agent-landing.mjs",
    "verify:concepts": "node scripts/verify-concept-semantics.mjs",
    "verify:maintenance": "node scripts/test-release-contract.mjs && node scripts/verify-maintenance.mjs",
    "sync:linux-portability": "node scripts/sync-linux-portability-notices.mjs",
    "check:linux-portability": "node scripts/sync-linux-portability-notices.mjs --check",
    "verify:deployment": "pnpm run build && wrangler deploy --config wrangler.jsonc --dry-run --outdir .wrangler-static && node scripts/verify-static-deployment.mjs",
    "verify:release": "node scripts/sync-linux-portability-notices.mjs --check && node scripts/test-linux-portability-contract.mjs && node scripts/verify-release-readiness.mjs",
    "verify:release-live": "node scripts/verify-release-readiness.mjs --live",
    "verify:clean-install": "node scripts/verify-clean-install.mjs",
    "reference:generate": "node scripts/generate-cli-reference.mjs && node scripts/generate-mcp-reference.mjs",
    "reference:check": "node scripts/generate-cli-reference.mjs --check && node scripts/generate-mcp-reference.mjs --check",
    "verify:reference": "node scripts/verify-reference.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "fumadocs-core": "16.11.5",
    "fumadocs-mdx": "15.2.0",
    "fumadocs-ui": "16.11.5",
    "lucide-react": "1.25.0",
    "next": "16.2.11",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260717.1",
    "@effect/platform-bun": "4.0.0-beta.98",
    "@effect/platform-node": "4.0.0-beta.98",
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdx": "2.0.14",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "alchemy": "2.0.0-beta.63",
    "effect": "4.0.0-beta.98",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.10",
    "postcss": "8.5.19",
    "sharp": "0.35.3",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "wrangler": "4.112.0"
  }
}
