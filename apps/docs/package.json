{
  "name": "@planr/docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "alchemy:dev": "alchemy dev --stage dev",
    "build": "next build",
    "build:worker": "opennextjs-cloudflare build --skipWranglerConfigCheck",
    "bundle:worker": "wrangler deploy --dry-run --outdir .alchemy-worker",
    "build:deploy": "pnpm run build:worker && pnpm run bundle:worker",
    "start": "next start",
    "deploy": "alchemy deploy --stage prod",
    "destroy": "alchemy destroy --stage prod",
    "content": "fumadocs-mdx",
    "typecheck": "fumadocs-mdx && tsc --noEmit",
    "lint": "eslint .",
    "verify:shell": "node scripts/verify-shell.mjs",
    "verify:onboarding": "node scripts/verify-onboarding.mjs",
    "verify:concepts": "node scripts/verify-concept-semantics.mjs",
    "verify:maintenance": "node scripts/verify-maintenance.mjs",
    "verify:deployment": "pnpm run build:deploy",
    "verify:release": "node scripts/verify-release-readiness.mjs",
    "verify:release-live": "node scripts/verify-release-readiness.mjs --live",
    "verify:clean-install": "node scripts/verify-clean-install.mjs",
    "reference:generate": "node scripts/generate-cli-reference.mjs && node scripts/generate-mcp-reference.mjs",
    "reference:check": "node scripts/generate-cli-reference.mjs --check && node scripts/generate-mcp-reference.mjs --check",
    "verify:reference": "node scripts/verify-reference.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "fumadocs-core": "16.11.5",
    "fumadocs-mdx": "15.2.0",
    "fumadocs-ui": "16.11.5",
    "lucide-react": "1.25.0",
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260717.1",
    "@effect/platform-bun": "4.0.0-beta.98",
    "@effect/platform-node": "4.0.0-beta.98",
    "@opennextjs/cloudflare": "1.20.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdx": "2.0.14",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "alchemy": "2.0.0-beta.63",
    "axe-core": "4.12.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.10",
    "effect": "4.0.0-beta.98",
    "postcss": "8.5.19",
    "rclone.js": "0.6.6",
    "sharp": "0.35.3",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "wrangler": "4.112.0"
  }
}
