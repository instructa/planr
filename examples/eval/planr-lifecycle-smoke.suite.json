  "cases": [
    {
      "case_id": "planr-lifecycle-baseline",
      "title": "Create a project, build a map, and close one item",
      "fixture_id": "lifecycle-fixture",
      "scorer_id": "planr-lifecycle-scorer",
      "fixture_ids": [
        "lifecycle-fixture"
      ],
      "scorer_ids": [
        "planr-lifecycle-scorer@1.0.0"
      ],
      "subject": {
        "kind": "planr_cli",
        "argv": [
          "node",
          "examples/eval/subjects/lifecycle-subject.mjs",
          "planr-lifecycle-baseline",
          ".planr/eval-lifecycle-counts.json",
          "from-file"
        ]
      },
      "assertions": [
        {
          "kind": "exit_code",
          "expected": 0
        },
        {
          "kind": "event_sequence",
          "expected": [
            "project_created",
            "map_built",
            "item_closed"
          ]
        }
      ],
      "tags": [
        "baseline",
        "candidate",
        "resume",
        "invalidation"
      ],
      "measures": [
