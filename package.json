{
  "name": "planr",
  "version": "1.4.0",
  "description": "Local-first planning and execution coordination for coding agents.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/instructa/planr.git"
  },
  "type": "module",
  "bin": {
    "planr": "npm/bin/planr.js"
  },
  "files": [
    "npm/bin/planr.js",
    "npm/native",
    "plugins",
    "presets",
    "evaluations",
    "website/_headers",
    "website/app.mjs",
    "website/catalog-model.mjs",
    "website/data/catalog.json",
    "website/index.html",
    "website/styles.css",
    "!website/README.md",
    "README.md",
    "LICENSE.md",
    "docs"
  ],
  "scripts": {
    "alchemy:check-runtime": "node scripts/check-alchemy-runtime.mjs",
    "build:native": "cargo build --release",
    "catalog:regenerate": "node scripts/regenerate-preset-catalog.mjs",
    "test": "cargo test",
    "pack:check": "npm pack --dry-run",
    "deploy:test": "node scripts/cloudflare-test.mjs deploy",
    "destroy:test": "node scripts/cloudflare-test.mjs destroy",
    "site:build": "node scripts/build-site.mjs",
    "site:check": "pnpm site:test && pnpm site:build",
    "site:test": "node --test website/*.test.mjs",
    "site:serve": "node website/serve.mjs"
  },
  "devDependencies": {
    "alchemy": "0.93.7"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@11.5.3+sha512.7ac1c919341c213a34dc0d02afb7143c5c26ac26ee8c4782deea821b8ac64d2134a081fd8941dae6e29bbb48f58dfc2b7fbceeccc07cb2f09d219d342a4969ed"
}
