#!/usr/bin/env sh
set -eu

script_dir="$(CDPATH=; cd -- "$(dirname -- "$0")" && pwd)"
package_root="$(CDPATH=; cd -- "$script_dir/.." && pwd)"

detect_target() {
  os_name="$(uname -s | tr '[:upper:]' '[:lower:]')"
  arch_name="$(uname -m)"

  case "$os_name" in
    darwin) os_name="darwin" ;;
    linux) os_name="linux" ;;
    *)
      echo "unsupported OS for planr-host-capability-validator: $os_name" >&2
      exit 127
      ;;
  esac

  case "$arch_name" in
    arm64 | aarch64) arch_name="arm64" ;;
    x86_64 | amd64) arch_name="x86_64" ;;
    *)
      echo "unsupported architecture for planr-host-capability-validator: $arch_name" >&2
      exit 127
      ;;
  esac

  printf '%s-%s\n' "$os_name" "$arch_name"
}

target="${PLANR_TARGET:-$(detect_target)}"

packaged_validator="$package_root/npm/native/$target/planr-host-capability-validator"
if [ -x "$packaged_validator" ]; then
  exec "$packaged_validator" "$@"
fi

if [ -f "$package_root/Cargo.toml" ]; then
  cargo_target_dir="$(cargo metadata --manifest-path "$package_root/Cargo.toml" --no-deps --format-version 1 | sed -n 's/.*"target_directory":"\([^"]*\)".*/\1/p' | head -n 1)"
  if [ -z "$cargo_target_dir" ]; then
    echo "cargo metadata did not return a target directory" >&2
    exit 127
  fi
  for profile in release debug; do
    candidate="$cargo_target_dir/$profile/planr-host-capability-validator"
    if [ -x "$candidate" ]; then
      exec "$candidate" "$@"
    fi
  done
  cargo build --manifest-path "$package_root/Cargo.toml" --bin planr-host-capability-validator >/dev/null
  exec "$cargo_target_dir/debug/planr-host-capability-validator" "$@"
fi

echo "planr-host-capability-validator binary was not found for $target" >&2
echo "Expected npm/native/$target/planr-host-capability-validator or a Cargo-configured local build." >&2
exit 127
