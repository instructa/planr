  "unknown_tool_error": "unknown Planr MCP tool",
  "install_fragments": {
    "codex": [
      "[mcp_servers.planr]",
      "command = \"planr\"",
      "args = [\"--db\""
    ],
    "claude": [
      "claude mcp add planr",
      "\"mcpServers\"",
      "\"planr\""
    ],
    "cursor": [
      ".cursor/mcp.json",
      "\"mcpServers\"",
      "\"planr\"",
      "cursor://anysphere.cursor-deeplink/mcp/install?name=planr&config="
    ],
    "grok": [
      "[mcp_servers.planr]",
      "args = [\"mcp\"]",
      "PLANR_MCP_CLIENT = \"grok\"",
      ".grok/skills/planr/SKILL.md",
      "hooks: unsupported/no-op"
    ]
  },
  "cli_reference_commands": [
    "planr install codex|claude|cursor|grok|pi",
    "planr prompt cli|mcp|http",
    "planr prompt routing",
    "planr agents init",
    "planr agents init --profile|--skill|--route|--default-route|--interactive",
    "planr prime",
    "planr install codex|claude|cursor|grok|pi [--dry-run] [--no-mcp] [--force] [--no-hooks]",
    "planr mcp",
    "planr review annotate",
