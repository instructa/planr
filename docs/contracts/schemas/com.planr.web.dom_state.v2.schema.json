{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://com.planr.web.dom_state.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_ref",
    "selector",
    "text",
    "visible",
    "contains_text",
    "excludes_text",
    "storage",
    "selected",
    "accessibility",
    "layout",
    "runtime"
  ],
  "properties": {
    "schema_ref": {
      "const": "schema://com.planr.web.dom_state.v2"
    },
    "selector": {
      "type": "string",
      "minLength": 1
    },
    "text": {
      "type": [
        "string",
        "null"
      ]
    },
    "visible": {
      "type": "boolean"
    },
    "contains_text": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "excludes_text": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "storage": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "key",
            "present",
            "transaction_count",
            "matches_snapshot"
          ],
          "properties": {
            "key": {
              "type": "string",
              "minLength": 1
            },
            "present": {
              "type": "boolean"
            },
            "transaction_count": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "matches_snapshot": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "selected": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unnamed_controls",
        "unlabelled_fields"
      ],
      "properties": {
        "unnamed_controls": {
          "type": "integer",
          "minimum": 0
        },
        "unlabelled_fields": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "horizontal_overflow"
      ],
      "properties": {
        "horizontal_overflow": {
          "type": "boolean"
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "error_count",
        "external_request_count"
      ],
      "properties": {
        "error_count": {
          "type": "integer",
          "minimum": 0
        },
        "external_request_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
