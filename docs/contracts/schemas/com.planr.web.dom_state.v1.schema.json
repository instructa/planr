{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://com.planr.web.dom_state.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_ref",
    "selector",
    "text",
    "visible"
  ],
  "properties": {
    "schema_ref": {
      "const": "schema://com.planr.web.dom_state.v1"
    },
    "selector": {
      "type": "string",
      "minLength": 1
    },
    "text": {
      "type": [
        "string",
        "null"
      ]
    },
    "visible": {
      "type": "boolean"
    }
  }
}
